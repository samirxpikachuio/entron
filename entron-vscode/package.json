{
  "name": "entron-language",
  "displayName": "Entron — The Modern programming language",
  "description": "Rich syntax highlighting, code snippets, bracket matching, and language configuration for the Entron programming language.",
  "version": "1.0.91",
  "publisher": "entron-team",
  "license": "MIT",
  "icon": "assets/entron-icon.png",
  "main": "./extension.js",
  "activationEvents": ["*"],
  "homepage": "https://github.com/samirxpikachuio/entron",
  "repository": {
    "type": "git",
    "url": "https://github.com/samirxpikachuio/entron"
  },
  "bugs": {
    "url": "https://github.com/samirxpikachuio/entron/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "entron",
    "plain-english",
    "natural-language",
    "programming-language",
    "syntax-highlighting"
  ],
  "contributes": {
    "languages": [
      {
        "id": "entron",
        "aliases": ["Entron", "entron"],
        "extensions": [".entron", ".ent"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/entron-icon.png",
          "dark": "./assets/entron-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "entron",
        "scopeName": "source.entron",
        "path": "./syntaxes/entron.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "entron",
        "path": "./snippets/entron.json"
      }
    ]
  }
}
