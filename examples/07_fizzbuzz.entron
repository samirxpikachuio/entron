note: The Classic FizzBuzz in Plain English

display "=== FizzBuzz in Entron (1 to 20) ==="

count from 1 to 20 as n do
    define variable rem3 as n modulo 3
    define variable rem5 as n modulo 5

    if rem3 is equal to 0 and rem5 is equal to 0 then
        display "FizzBuzz"
    otherwise if rem3 is equal to 0 then
        display "Fizz"
    otherwise if rem5 is equal to 0 then
        display "Buzz"
    otherwise
        display n
    end if
end count
