{
  "name": "entron-language",
  "displayName": "Entron — The Modern Plain-English Language",
  "description": "Rich syntax highlighting, file icons, and language configuration for the Entron plain-English programming language.",
  "version": "1.0.1",
  "publisher": "entron-team",
  "icon": "assets/entron-icon.png",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "entron",
        "aliases": ["Entron", "entron"],
        "extensions": [".entron", ".ent"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/entron-icon.png",
          "dark": "./assets/entron-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "entron",
        "scopeName": "source.entron",
        "path": "./syntaxes/entron.tmLanguage.json"
      }
    ]
  }
}
